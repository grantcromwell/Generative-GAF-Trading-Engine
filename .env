# ============================================
# NVIDIA API Configuration for Brainnet/Banis
# ============================================

# LLM Backend Configuration
LLM_BACKEND=openai
LLM_BASE_URL=https://integrate.api.nvidia.com
LLM_API_KEY=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

# DeepSeek-R1 Model (via NVIDIA)
DEEPSEEK_MODEL=deepseek-ai/deepseek-r1-distill-qwen-7b
OLLAMA_MODEL=deepseek-ai/deepseek-r1-distill-qwen-7b

# Model Settings
AGENT_MAX_TOKENS=4096
AGENT_TEMPERATURE=0.6
AGENT_TOP_P=0.7

# ============================================
# Memory Configuration
# ============================================

# Memory backend (pgvector, sqlite, or none)
MEMORY_DB=sqlite
SQLITE_PATH=brainnet_memory.db

# ============================================
# Trading Configuration
# ============================================

# Default symbol (ES=F for Banis - S&P 500 E-mini futures)
YFINANCE_SYMBOL=ES=F

# Confidence thresholds
CONFIDENCE_THRESHOLD=0.78
MAX_REFINEMENTS=3

# ============================================
# ConvNeXt Neural Network (Optional)
# ============================================

CONVNEXT_ENABLED=false
CONVNEXT_MODEL=convnext_tiny
CONVNEXT_DEVICE=auto
CONVNEXT_WEIGHTS=IMAGENET1K_V1

# ============================================
# System Settings
# ============================================

LOG_LEVEL=INFO
DEBUG=false
USE_VISION=false

# ============================================
# API Keys (Keep for reference)
# ============================================

NVIDIA_API_KEY=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
COINBYMARKETCAP_API_KEY=621cedd4543f4f0d96ba89d08b804218
